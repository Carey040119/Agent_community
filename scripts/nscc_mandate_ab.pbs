#!/bin/bash
# =====================================================================
# NSCC ASPIRE2A: mandate propagation — Qwen3.8-27B + external skill
#   MANDATE=on only (baseline OFF = 0% coverage already established in
#   the earlier Qwen2.5 run; see MANDATE_PROPAGATION_REPORT.md §4.)
#   EXTERNAL_SKILL=on: an injected external consultant authors the SOP;
#   CEO ADOPTS and issues the mandate.
#
# This is the Qwen3.8 round. The Qwen3-14B round-4 result was cov_all
# 0.97 with 1 structural miss. Qwen3.8-27B (released 2026-08-14) is
# Alibaba's newer dense open-weight model; its FP8 variant has the same
# ~28 GB VRAM footprint as Qwen3-14B BF16, so it drops in on the same
# A100-40GB with no PBS changes beyond the model id.
#
# Option A fixes (from the first Qwen3 run) are retained:
#   (a) --max-tokens 2048  (room for actions after any residual CoT)
#   (b) chat_template_kwargs.enable_thinking=false  (disable thinking
#        at the vLLM template layer; Qwen3.8 inherits this hook)
# Group broadcast (commit 5db068c) is in effect — one send_group_mail
# fans the mandate to the entire team.
#
#   qsub scripts/nscc_mandate_ab.pbs
# =====================================================================
#PBS -N mandate_ab_qwen38_ext
#PBS -l select=1:ngpus=1:mem=64gb
#PBS -l walltime=14:00:00
#PBS -q normal
#PBS -P personal-khuang01
#PBS -j oe
#PBS -o mandate_ab.log

set -uo pipefail
cd "$PBS_O_WORKDIR"

# ---------------------------------------------------------------------
# Local vLLM — Qwen3.8-27B-FP8 (Apache-2.0, open weights, 2026-08-14).
# FP8 variant is ~28 GB and fits a single A100-40GB (same memory
# footprint as Qwen3-14B BF16). If your card is A100-80GB, switch to
# "Qwen/Qwen3.8-27B" (BF16, ~56 GB) and raise --gpu-memory-utilization.
# ---------------------------------------------------------------------
export HF_HOME=/scratch/users/ntu/khuang01/hf
export HF_HUB_OFFLINE=1
MODEL="Qwen/Qwen3.8-27B-FP8"
PORT=$(shuf -i 23000-39000 -n 1)

module load miniforge3/26.7.2
eval "$(conda shell.bash hook)"
conda activate /scratch/users/ntu/khuang01/aces/envs/vllm
nvidia-smi --query-gpu=name,memory.total --format=csv || true
export CUDA_VISIBLE_DEVICES=0

echo "[$(date)] starting vLLM: $MODEL"
python -m vllm.entrypoints.openai.api_server \
    --model "$MODEL" \
    --served-model-name local-llm \
    --port "$PORT" \
    --max-model-len 8192 \
    --gpu-memory-utilization 0.90 \
    --enforce-eager \
    > vllm_server.log 2>&1 &
VLLM_PID=$!
trap 'echo stopping vLLM; kill $VLLM_PID 2>/dev/null || true' EXIT

echo "[$(date)] waiting for vLLM on port $PORT (model local-llm)..."
for i in $(seq 1 180); do
    code=$(curl -s -o /dev/null -w "%{http_code}" -X POST \
        "http://localhost:$PORT/v1/chat/completions" \
        -H "Content-Type: application/json" \
        -d '{"model":"local-llm","messages":[{"role":"user","content":"hi"}],"max_tokens":1}' \
        2>/dev/null)
    if [ "$code" = "200" ]; then
        echo "[$(date)] vLLM serving after ${i}0s"; break
    fi
    sleep 10
    if ! kill -0 $VLLM_PID 2>/dev/null; then
        echo "FATAL: vLLM died"; tail -60 vllm_server.log; exit 1
    fi
    if [ "$i" -eq 180 ]; then
        echo "FATAL: vLLM never served chat"; tail -60 vllm_server.log; exit 1
    fi
done

# ---------------------------------------------------------------------
# Point the sim at the local endpoint
# ---------------------------------------------------------------------
export EXP_BACKEND=openrouter
export EXP_BASE_URL="http://localhost:$PORT/v1"
export LLM_API_KEY=dummy
export EXP_MODEL=local-llm
export ALLOW_NONCANON_MODEL=1
export EXP_CONCURRENCY=8
export OUTPUT_DIR=results/mandate_ab
mkdir -p "$OUTPUT_DIR"

# ---------------------------------------------------------------------
# ON-only sweep across 3 seeds, external-skill condition. We skip OFF
# because the earlier Qwen2.5 run established 0% baseline coverage with
# high confidence (3/3 seeds); re-verifying that here would waste GPU
# time. If a sanity check is needed, flip MANDATE=both for one seed.
# ---------------------------------------------------------------------
export MANDATE_DAYS=3
export MANDATE=on
export EXTERNAL_SKILL=on
# Option A fixes for Qwen3:
#   (a) raise per-turn budget so action JSON fits after any residual CoT
#   (b) disable Qwen3 thinking via vLLM's chat_template_kwargs — the
#       flag is dropped silently by backends that don't understand it,
#       so this does not affect other models in future reuses.
export MANDATE_MAX_TOKENS=2048
export EXP_EXTRA_PARAMS='{"chat_template_kwargs":{"enable_thinking":false}}'
for SEED in 11 17 29; do
    export MANDATE_SEED=$SEED
    echo "===== SEED=$SEED (MANDATE=on, EXTERNAL_SKILL=on) ====="
    python scripts/run_mandate_ab.py || echo "run_mandate_ab failed for seed=$SEED"
done
echo "[$(date)] SIM DONE"

# ---------------------------------------------------------------------
# Readout: per-seed external-skill results
# ---------------------------------------------------------------------
echo "===== MANDATE ON (external skill, Qwen3-14B) READOUT ====="
python3 -I - <<'PY'
import collections, glob, json, statistics
rows = []
for p in sorted(glob.glob("results/mandate_ab/mandate_ab_on_ext_s*.json")):
    r = json.load(open(p))
    rows.append(r)
    seed = p.split("_s")[-1].split(".")[0]
    print(f"seed={seed}  cov_all={r['skill_coverage_all']:.2f}"
          f"  cov_leaves={r['skill_coverage_leaves']:.2f}"
          f"  depth_max={r['mandate_depth_max']}"
          f"  hops={r['mandate_hops']}"
          f"  jcr={r['jcr']:.2f}"
          f"  sit={r['accept_and_sit_rate']:.2f}"
          f"  gap_struct={r.get('gap_structural','?')}"
          f"  gap_behav={r.get('gap_behavioural','?')}")
if rows:
    mean = lambda k: statistics.mean(r[k] for r in rows)
    print(f"MEAN: cov_all={mean('skill_coverage_all'):.2f}"
          f"  cov_leaves={mean('skill_coverage_leaves'):.2f}"
          f"  jcr={mean('jcr'):.2f}"
          f"  depth_max={statistics.mean(r['mandate_depth_max'] for r in rows):.1f}"
          f"  gap_struct={mean('gap_structural'):.1f}"
          f"  gap_behav={mean('gap_behavioural'):.1f}")

print()
print("===== RESIDUAL GAP: WHO MISSED THE SKILL =====")
# One line per non-adopter: id/role/manager/reached-by-mandate/bucket.
# Aggregate across seeds to find structural gaps (same role missed every time).
role_hits = collections.Counter()
role_total = collections.Counter()
for r in rows:
    for g in r.get("gap_rows", []):
        role_total[g["role"]] += 1
        if g["bucket"] == "structural":
            role_hits[g["role"]] += 1
    seed = next(iter(r.get("gap_rows", [{}])), {}).get("id", "")
for p in sorted(glob.glob("results/mandate_ab/mandate_ab_on_ext_s*.json")):
    r = json.load(open(p))
    seed = p.split("_s")[-1].split(".")[0]
    rows_ = r.get("gap_rows", [])
    if not rows_:
        print(f"seed={seed}: no gap (full coverage)")
        continue
    print(f"seed={seed}: {len(rows_)} non-adopter(s)")
    for g in sorted(rows_, key=lambda x: (x["bucket"], x["role"], x["id"])):
        print(f"  {g['bucket']:12s} id={g['id']:16s} role={g['role']:20s}"
              f" manager={g.get('manager_id') or '-':12s}"
              f" zone={g['zone']:8s} reached={g['reached_by_mandate']}")
print()
print("ROLES MOST-OFTEN MISSED STRUCTURALLY (across seeds):")
for role, hits in role_hits.most_common():
    total = role_total[role]
    print(f"  {role:24s} structural={hits}/{total} runs")
PY
echo "[$(date)] ALL DONE"
